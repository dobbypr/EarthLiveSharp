# Maintainer: Your Name <you@example.com>
pkgname=earthlivesharp
pkgver=4.0
pkgrel=1
pkgdesc="Live satellite imagery wallpaper daemon (Himawari-9 / NASA EPIC)"
arch=('x86_64')
url="https://github.com/dobbypr/EarthLiveSharp"
license=('MIT')
depends=('dotnet-runtime-8.0')
makedepends=('dotnet-sdk-8.0')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/heads/master.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/EarthLiveSharp-master"
    dotnet publish src/EarthLiveSharp.Cli/EarthLiveSharp.Cli.csproj \
        -r linux-x64 \
        --self-contained false \
        -c Release \
        -o "$srcdir/out"
}

package() {
    cd "$srcdir"
    install -Dm755 "out/earthlivesharp" "$pkgdir/usr/bin/earthlivesharp"
    install -Dm644 "EarthLiveSharp-master/packaging/earthlivesharp.desktop" \
        "$pkgdir/etc/xdg/autostart/earthlivesharp.desktop"
    install -Dm644 "EarthLiveSharp-master/packaging/earthlivesharp.service" \
        "$pkgdir/usr/lib/systemd/user/earthlivesharp.service"
    install -Dm644 "EarthLiveSharp-master/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
